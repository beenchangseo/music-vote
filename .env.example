# 로컬 개발용 환경변수. 복사해서 .env.local 로 쓴다: cp .env.example .env.local
# 값은 Vercel Production 환경변수와 같은 이름이다. 실제 값은 커밋하지 않는다.

# Supabase (필수). Project Settings > API Keys
# 변수 이름은 레거시 시절 그대로이고 값은 새 형식이다: ANON_KEY 에 sb_publishable_…, SERVICE_ROLE_KEY 에 sb_secret_…
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# RLS 를 건너뛰는 서버 전용 키. NEXT_PUBLIC_ 를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Vercel Cron 인증 (Authorization: Bearer <CRON_SECRET>). 로컬에선 생략 가능, 프로덕션은 필수.
# openssl rand -hex 32
CRON_SECRET=

# 공유 카드 이미지(/api/og) 서명 키. 서버에서만 쓴다. NEXT_PUBLIC_ 를 붙이지 않는다. 32자 이상: openssl rand -hex 32
# 비우거나 짧으면 모든 공유 카드가 로고만 있는 기본 카드로 나가고 서버 로그에 [share-card] 가 남는다.
# 바꿀 때는 지금 값을 OG_SIGNING_SECRET_PREVIOUS 로 옮기고 새 값을 넣는다. PREVIOUS 는 검증에만 쓴다.
# 키가 새어 나갔으면 PREVIOUS 를 비워 옛 서명을 모두 끊는다.
OG_SIGNING_SECRET=
OG_SIGNING_SECRET_PREVIOUS=

# 카카오 어드민 키 (탈퇴할 때 카카오 연결 해제). 서버에서만 쓴다.
# 비우면 카카오 로그인 계정은 탈퇴하지 못한다(카카오 정책상 연결 해제가 먼저다).
# 값: 앱 관리 페이지 [앱] > [플랫폼 키] > [어드민 키]. 같은 화면의 [사용 가능 API] 가 "모든 API 사용 가능"이거나,
#   "특정 API 사용 가능"이면 카카오 로그인 카테고리의 "연결 해제"가 골라져 있어야 한다. 아니면 -3 으로 거절된다.
#   2025-12-03 개편 전에 만든 키는 "모든 API 사용 가능"으로 옮겨졌다(https://developers.kakao.com/docs/ko/app-setting/app).
# [호출 허용 IP 주소] 는 비워 둔다. Vercel 함수는 나가는 IP 가 고정이 아니라, 등록하면 -401 "ip mismatched" 로 거절된다.
KAKAO_ADMIN_KEY=

# 카카오톡 채널 1:1 채팅 주소 (선택). 카카오톡 채널 관리자센터에서 받는다: https://pf.kakao.com/_<채널ID>/chat
# 비우면 /support 의 문의 버튼이 "카카오톡 채널을 준비하고 있어요"로 꺼진다. 빌드할 때 박히므로 바꾼 뒤 다시 배포한다.
NEXT_PUBLIC_KAKAO_CHANNEL_CHAT_URL=

# YouTube Data API v3 (선택). 없으면 재생시간 자동 채우기·임베드 검사·검색만 꺼진다.
# 서버에서만 쓴다. NEXT_PUBLIC_ 를 붙이면 브라우저에 실려 남이 쿼터를 쓴다.
YOUTUBE_API_KEY=

# e2e 게이트 (npm run test:e2e). 뜻은 e2e/README.md
E2E_ROOM_SHARE_CODE=
E2E_ACCOUNT_IDS=
E2E_ROOM_TITLE=
E2E_ACCOUNT_A_HAS_VOTE=

# npm run metrics:teams. 운영자 본인 user id(쉼표 구분)와 팀 기능 배포일(YYYY-MM-DD, KST)
METRICS_OPERATOR_IDS=
TEAM_LAUNCH_DATE=
