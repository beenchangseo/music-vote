# 로컬 개발용 환경변수. 복사해서 .env.local 로 쓴다: cp .env.example .env.local
# 값은 Vercel Production 환경변수와 같은 이름이다. 실제 값은 커밋하지 않는다.

# Supabase (필수). Project Settings > API Keys
# 변수 이름은 레거시 시절 그대로이고 값은 새 형식이다: ANON_KEY 에 sb_publishable_…, SERVICE_ROLE_KEY 에 sb_secret_…
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# RLS 를 건너뛰는 서버 전용 키. NEXT_PUBLIC_ 를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Vercel Cron 인증 (Authorization: Bearer <CRON_SECRET>). 로컬에선 생략 가능, 프로덕션은 필수.
# openssl rand -hex 32
CRON_SECRET=

# 카카오 어드민 키 (탈퇴할 때 카카오 연결 해제). Kakao Developers > 앱 > 어드민 키. 서버에서만 쓴다.
# 비우면 카카오 로그인 계정은 탈퇴하지 못한다(카카오 정책상 연결 해제가 먼저다).
# 어드민 키로 부를 API 에 "카카오 로그인 > 연결 해제"를 넣는다(https://developers.kakao.com/docs/ko/reference/admin-key-api).
# 빠지면 -3(403)으로 거절된다(https://developers.kakao.com/docs/ko/rest-api/error-code).
# IP 제한 같은 다른 설정에서 무슨 코드가 오는지는 확인하지 않았다.
KAKAO_ADMIN_KEY=

# YouTube Data API v3 (선택). 없으면 재생시간 자동 채우기·임베드 검사·검색만 꺼진다.
# 서버에서만 쓴다. NEXT_PUBLIC_ 를 붙이면 브라우저에 실려 남이 쿼터를 쓴다.
YOUTUBE_API_KEY=

# e2e 게이트 (npm run test:e2e). 뜻은 e2e/README.md
E2E_ROOM_SHARE_CODE=
E2E_ACCOUNT_IDS=
E2E_ROOM_TITLE=
E2E_ACCOUNT_A_HAS_VOTE=

# npm run metrics:teams. 운영자 본인 user id(쉼표 구분)와 팀 기능 배포일(YYYY-MM-DD, KST)
METRICS_OPERATOR_IDS=
TEAM_LAUNCH_DATE=
